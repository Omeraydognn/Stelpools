PORT=8790
LOG_LEVEL=info
# Every origin allowed to call this anchor. Add the deployed site here too.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://stelpools.vercel.app

# Must match VITE_ANCHOR_HOME_DOMAIN in the web app: the domain is signed
# into every SEP-10 challenge, so a mismatch rejects every login.
HOME_DOMAIN=localhost:8790
PUBLIC_URL=http://localhost:8790

NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org

# Signs SEP-10 challenges. Holds no funds, needs no account, must NOT be the
# issuer: a key that does both lets a login challenge double as a payment
# authorisation.
SEP10_SIGNING_SECRET=
# At least 32 characters. Anyone holding this can mint tokens on the JWTs it
# signs, so treat it like the issuer key.
JWT_SECRET=

# Issues aTRY. A deposit is a payment from here; a withdrawal is a payment
# back to here, which burns the tokens.
ATRY_ISSUER_SECRET=
ATRY_CODE=aTRY

# The ledger. Not optional: it is how the anchor remembers who it owes.
# On Vercel, attaching a Postgres store sets POSTGRES_URL and this can be
# left blank.
DATABASE_URL=postgres://localhost:5432/anchor

# `timer` for a host that keeps a process alive, `request` for a function
# host where the requests have to drive the work instead.
WORKER_MODE=timer

# The bank account a depositor actually sends lira to.
BANK_NAME=Stelpools Test Bank A.Ş.
BANK_IBAN=TR000000000000000000000001
BANK_ACCOUNT_HOLDER=Stelpools Teknoloji A.Ş.

# aTRY is a receipt for lira, so there is no exchange rate — only this fee.
FEE_BPS=0
MIN_DEPOSIT_TRY=50
MAX_DEPOSIT_TRY=50000

WORKER_INTERVAL_MS=2000
MAX_PAYOUT_ATTEMPTS=8

# Testnet only. Exposes an endpoint that mints aTRY against a bank transfer
# nobody made. Set it to false anywhere real money could be involved.
ALLOW_SIMULATED_TRANSFERS=true

# Only for `npm test`: a throwaway Postgres for the ledger tests. Without
# it those tests skip rather than fail.
# TEST_DATABASE_URL=postgres://localhost:5432/anchor_test
